# Local defaults work without changing this file.
# Copy to .env for a public deployment and change the URLs/tokens.
BP1P_DIRECTORY_PUBLIC_URL=http://localhost:8080
BP1P_DIRECTORY_URL=http://directory:8080
BP1P_DIRECTORY_ADMIN_TOKEN=bp1p-local-directory-admin
BP1P_NODE_PUBLIC_URL=http://localhost:8081
BP1P_NODE_NAME=Local BP1P Node
BP1P_NODE_ADMIN_TOKEN=bp1p-local-node-admin
BP1P_ALLOW_PRIVATE_UPSTREAMS=false
